\usepackage{diffcoeff}
\usepackage{amsthm}
\usepackage{accents}

% 主要字體設定 (ScholaX + NewTX Math)
\usepackage[scaled = 0.9]{scholax}
% 數學字體務必放在 amsmath 之後載入
\usepackage[scaled = 0.95,varbb]{newtxmath}

% ==========================================
% 實用套件 (Utilities & Formatting)
